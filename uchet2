<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Учет выдачи оборудования</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-body: #f1f5f9;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --success: #10b981;
            --success-hover: #059669;
            --warning-bg: #fffbeb;
            --warning-border: #f59e0b;
            --warning-text: #b45309;
            --danger-bg: #fef2f2;
            --danger-text: #b91c1c;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-body);
            margin: 0;
            padding: 30px 20px;
            color: var(--text-main);
            line-height: 1.5;
        }

        .container { max-width: 1120px; margin: 0 auto; }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.02em;
        }

        .header-subtitle { color: var(--text-muted); font-size: 14px; margin: 4px 0 0 0; }

        .stats-pill {
            background: var(--bg-card);
            border: 1px solid var(--border);
            padding: 8px 16px;
            border-radius: 99px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-muted);
            box-shadow: 0 1px 2px rgba(0,0,0,0.03);
        }

        .stats-pill strong { color: var(--primary); font-weight: 700; }

        .card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
            margin-bottom: 24px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .card-title { margin: 0; font-size: 16px; font-weight: 600; color: var(--text-main); }

        .alert-box {
            background-color: var(--warning-bg);
            border: 1px solid #fde68a;
            border-left: 4px solid var(--warning-border);
            padding: 16px 20px;
            margin-bottom: 24px;
            border-radius: 12px;
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .alert-box h3 { margin: 0 0 8px 0; color: var(--warning-text); font-size: 15px; font-weight: 600; }
        .alert-box ul { margin: 0; padding-left: 20px; color: #92400e; font-size: 14px; }
        .alert-box li + li { margin-top: 4px; }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .field-group { display: flex; flex-direction: column; }

        label { font-size: 13px; font-weight: 500; color: #334155; margin-bottom: 6px; }

        input, select {
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 14px;
            font-family: inherit;
            color: var(--text-main);
            background-color: #f8fafc;
            transition: all 0.2s ease;
            width: 100%;
        }

        input:focus, select:focus {
            outline: none;
            background-color: #ffffff;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
        }

        .filter-bar {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .search-box { flex: 1; min-width: 220px; position: relative; }
        .filter-select { width: 230px; cursor: pointer; }

        .actions-row { display: flex; gap: 12px; flex-wrap: wrap; }

        button {
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            font-family: inherit;
            border: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary { background-color: var(--primary); color: white; box-shadow: 0 1px 2px rgba(79, 70, 229, 0.3); }
        .btn-primary:hover { background-color: var(--primary-hover); transform: translateY(-1px); }

        .btn-secondary { background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; }
        .btn-secondary:hover { background-color: #e2e8f0; }

        .btn-return {
            background-color: #ecfdf5;
            color: var(--success-hover);
            border: 1px solid #a7f3d0;
            padding: 6px 12px;
            font-size: 13px;
            border-radius: 8px;
        }

        .btn-return:hover { background-color: var(--success); color: white; border-color: var(--success); }

        .table-wrapper { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }

        th {
            padding: 12px 16px;
            text-align: left;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            background-color: #f8fafc;
            border-bottom: 1px solid var(--border);
        }

        th:first-child { border-top-left-radius: 10px; }
        th:last-child { border-top-right-radius: 10px; }

        td { padding: 14px 16px; font-size: 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }

        tbody tr { transition: background-color 0.15s ease; }
        tbody tr:hover { background-color: #f8fafc; }
        tbody tr:last-child td { border-bottom: none; }

        .id-badge {
            font-family: monospace;
            color: var(--text-muted);
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 6px;
            font-size: 12px;
        }

        .room-tag {
            background: #eef2ff;
            color: var(--primary);
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 13px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge-ok { background-color: #f1f5f9; color: #475569; }
        .badge-tomorrow { background-color: #fef3c7; color: #b45309; }
        .badge-danger { background-color: #fee2e2; color: #b91c1c; }

        .tomorrow-row { background-color: #fffdf5; }
        .overdue-row { background-color: #fecaca; }
        .overdue-row:hover { background-color: #fca5a5; }

        .empty-msg { text-align: center; color: var(--text-muted); padding: 40px 20px; font-size: 15px; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div>
            <h1>📦 Учет выдачи оборудования</h1>
            <p class="header-subtitle">Контроль сроков возврата техники и инвентаря</p>
        </div>
        <div class="stats-pill">
            На руках: <strong id="totalCount">0</strong> ед.
        </div>
    </div>

    <div id="reminderBox" class="alert-box">
        <h3>🔔 Напоминание: завтра истекает срок выдачи!</h3>
        <ul id="reminderList"></ul>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Оформить выдачу оборудования</h2>
        </div>
        <form id="issueForm">
            <div class="form-grid">
                <div class="field-group">
                    <label for="equipment">Оборудование</label>
                    <input type="text" id="equipment" placeholder="Например: Ноутбук Asus" required>
                </div>
                <div class="field-group">
                    <label for="room">Кабинет</label>
                    <input type="text" id="room" placeholder="№ 204" required>
                </div>
                <div class="field-group">
                    <label for="fullName">ФИО получателя</label>
                    <input type="text" id="fullName" placeholder="Иванов И.И." required>
                </div>
                <div class="field-group">
                    <label for="phone">Телефон</label>
                    <input type="tel" id="phone" placeholder="+7 (999) 000-00-00" required>
                </div>
                <div class="field-group">
                    <label for="durationSelect">Срок выдачи</label>
                    <select id="durationSelect" onchange="applyDuration()">
                        <option value="1d">На 1 день</option>
                        <option value="7d">На 1 неделю</option>
                        <option value="14d">На 2 недели</option>
                        <option value="1m" selected>На 1 месяц</option>
                        <option value="3m">На 3 месяца</option>
                        <option value="6m">На 6 месяцев</option>
                        <option value="1y">На 1 год</option>
                        <option value="custom">Своя дата...</option>
                    </select>
                </div>
                <div class="field-group">
                    <label for="returnDate">Дата сдачи</label>
                    <input type="date" id="returnDate" onchange="setCustomDuration()" required>
                </div>
            </div>
            <div class="actions-row">
                <button type="submit" class="btn-primary">➕ Выдать оборудование</button>
                <button type="button" class="btn-secondary" onclick="checkReminders(true)">🔔 Проверить уведомления</button>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Оборудование на руках</h2>
        </div>

        <div class="filter-bar">
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="🔍 Поиск по оборудованию, ФИО, кабинету или телефону..." oninput="renderTable()">
            </div>
            <select id="statusFilter" class="filter-select" onchange="renderTable()">
                <option value="all">Все статусы</option>
                <option value="urgent">⚠️ Сдача сегодня и завтра</option>
                <option value="overdue">❌ Только просроченные</option>
                <option value="ok">✅ В норме (больше 1 дня)</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Оборудование</th>
                        <th>Кабинет</th>
                        <th>Получатель</th>
                        <th>Телефон</th>
                        <th>Дата сдачи</th>
                        <th>Статус</th>
                        <th>Действие</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <tr>
                        <td colspan="8" class="empty-msg">Сейчас все оборудование на месте</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let records = JSON.parse(localStorage.getItem('equipmentRecords')) || [];
    let nextId = records.length > 0 ? Math.max(...records.map(r => r.id)) + 1 : 1;

    function saveRecords() {
        localStorage.setItem('equipmentRecords', JSON.stringify(records));
    }

    function calculateReturnDate(duration) {
        const target = new Date();
        if (duration === '1d') target.setDate(target.getDate() + 1);
        else if (duration === '7d') target.setDate(target.getDate() + 7);
        else if (duration === '14d') target.setDate(target.getDate() + 14);
        else if (duration === '1m') target.setMonth(target.getMonth() + 1);
        else if (duration === '3m') target.setMonth(target.getMonth() + 3);
        else if (duration === '6m') target.setMonth(target.getMonth() + 6);
        else if (duration === '1y') target.setFullYear(target.getFullYear() + 1);

        const year = target.getFullYear();
        const month = String(target.getMonth() + 1).padStart(2, '0');
        const day = String(target.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function applyDuration() {
        const duration = document.getElementById('durationSelect').value;
        if (duration !== 'custom') {
            document.getElementById('returnDate').value = calculateReturnDate(duration);
        }
    }

    function setCustomDuration() {
        document.getElementById('durationSelect').value = 'custom';
    }

    window.onload = function() {
        applyDuration();
        renderTable();
        checkReminders(false);
    };

    document.getElementById('issueForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const record = {
            id: nextId++,
            equipment: document.getElementById('equipment').value.trim(),
            room: document.getElementById('room').value.trim(),
            fullName: document.getElementById('fullName').value.trim(),
            phone: document.getElementById('phone').value.trim(),
            returnDate: document.getElementById('returnDate').value
        };
        records.push(record);
        saveRecords();
        
        this.reset();
        document.getElementById('durationSelect').value = '1m';
        applyDuration();
        renderTable();
        checkReminders(false);
    });

    function returnItem(id) {
        records = records.filter(item => item.id !== id);
        saveRecords();
        renderTable();
        checkReminders(false);
    }

    function getDaysLeft(returnDateStr) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        
        const [year, month, day] = returnDateStr.split('-').map(Number);
        const target = new Date(year, month - 1, day);
        target.setHours(0, 0, 0, 0);
        
        const diffTime = target - today;
        return Math.round(diffTime / (1000 * 60 * 60 * 24));
    }

    function renderTable() {
        const tbody = document.getElementById('tableBody');
        const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();
        const statusFilter = document.getElementById('statusFilter').value;

        document.getElementById('totalCount').textContent = records.length;
        tbody.innerHTML = '';

        const filteredRecords = records.filter(item => {
            const daysLeft = getDaysLeft(item.returnDate);
            const matchesSearch = 
                item.equipment.toLowerCase().includes(searchQuery) ||
                item.fullName.toLowerCase().includes(searchQuery) ||
                item.room.toLowerCase().includes(searchQuery) ||
                item.phone.toLowerCase().includes(searchQuery);

            if (!matchesSearch) return false;

            if (statusFilter === 'urgent') return daysLeft === 0 || daysLeft === 1;
            if (statusFilter === 'overdue') return daysLeft < 0;
            if (statusFilter === 'ok') return daysLeft > 1;

            return true;
        });

        if (records.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" class="empty-msg">✨ Сейчас все оборудование на месте</td></tr>';
            return;
        }

        if (filteredRecords.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" class="empty-msg">🔍 По вашему запросу ничего не найдено</td></tr>';
            return;
        }

        filteredRecords.forEach(item => {
            const daysLeft = getDaysLeft(item.returnDate);
            const formattedDate = formatDate(item.returnDate);
            let rowClass = '';
            let badgeHtml = `<span class="badge badge-ok">Осталось ${daysLeft} дн.</span>`;

            if (daysLeft === 1) {
                rowClass = 'tomorrow-row';
                badgeHtml = '<span class="badge badge-tomorrow">⚠️ Завтра (1 дн.)</span>';
            } else if (daysLeft === 0) {
                rowClass = 'overdue-row';
                badgeHtml = '<span class="badge badge-danger">🔥 Сдача сегодня</span>';
            } else if (daysLeft < 0) {
                rowClass = 'overdue-row';
                badgeHtml = `<span class="badge badge-danger">❌ Просрочено (${Math.abs(daysLeft)} дн.)</span>`;
            }

            const tr = document.createElement('tr');
            if (rowClass) tr.className = rowClass;

            tr.innerHTML = `
                <td><span class="id-badge">#${item.id}</span></td>
                <td><strong>${item.equipment}</strong></td>
            tr.innerHTML = `
                <td><span class="id-badge">#${item.id}</span></td>
                <td><strong>${item.equipment}</strong></td>
                <td><span class="room-tag">Каб. ${item.room}</span></td>
                <td>${item.fullName}</td>
                <td style="color: var(--text-muted);">${item.phone}</td>
                <td>${formattedDate}</td>
                <td>${badgeHtml}</td>
                <td><button class="btn-return" onclick="returnItem(${item.id})">✓ Принять</button></td>
            `;
            tbody.appendChild(tr);
        });
    }

    function checkReminders(manualClick) {
        const dueTomorrow = records.filter(item => getDaysLeft(item.returnDate) === 1);
        const box = document.getElementById('reminderBox');
        const list = document.getElementById('reminderList');
        list.innerHTML = '';

        if (dueTomorrow.length > 0) {
            dueTomorrow.forEach(item => {
                const li = document.createElement('li');
                li.innerHTML = `<b>${item.equipment}</b> — Кабинет №${item.room}, ${item.fullName} (${item.phone})`;
                list.appendChild(li);
            });
            box.style.display = 'block';
            if (manualClick) {
                alert(`Напоминание! Завтра нужно сдать ${dueTomorrow.length} ед. оборудования. Подробности в желтом блоке сверху.`);
            }
        } else {
            box.style.display = 'none';
            if (manualClick) {
                alert('На завтра сдач оборудования не запланировано.');
            }
        }
    }

    function formatDate(dateStr) {
        const [year, month, day] = dateStr.split('-');
        return `${day}.${month}.${year}`;
    }
</script>

</body>
</html>
